{
  "name": "@tgmc/web-layer-admin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Nuxt layer: portfolio admin pages, write APIs, and Bearer-token auth helpers.",
  "main": "./nuxt.config.ts",
  "exports": {
    ".": "./nuxt.config.ts",
    "./server/utils/admin-auth": "./server/utils/admin-auth.ts",
    "./server/utils/admin-handler": "./server/utils/admin-handler.ts",
    "./server/utils/admin-blog-api": "./server/utils/admin-blog-api.ts",
    "./shared/blog-types": "./shared/blog-types.ts"
  },
  "files": [
    "app",
    "server",
    "shared",
    "nuxt.config.ts",
    "!**/*.{test,spec}.{js,mjs,cjs,ts,mts,cts,jsx,tsx}"
  ],
  "keywords": [
    "nuxt",
    "nuxt-layer",
    "admin",
    "tgmc"
  ],
  "peerDependencies": {
    "nuxt": "^4.0.0"
  },
  "dependencies": {
    "h3": "^1.15.11"
  },
  "devDependencies": {
    "nuxt": "^4.3.1"
  },
  "nx": {
    "tags": [
      "type:nuxt-layer"
    ],
    "targets": {
      "build": {
        "executor": "nx:noop",
        "cache": true
      }
    }
  }
}
