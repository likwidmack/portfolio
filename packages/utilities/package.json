{
  "name": "@tgmc/utilities",
  "version": "1.0.0",
  "type": "module",
  "description": "Shared TypeScript utilities for TGMC apps (env helpers, events, storage, deep assign/set, logging).",
  "author": "Tamara G Mack",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git@github.com:likwidmack/portfolio.git",
    "directory": "packages/utilities"
  },
  "homepage": "https://github.com/likwidmack/portfolio/tree/main/packages/utilities",
  "bugs": {
    "url": "https://github.com/likwidmack/portfolio/issues"
  },
  "keywords": [
    "utilities",
    "typescript",
    "tgmc"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "tgmc-portfolio": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./browser": {
      "tgmc-portfolio": "./src/browser.ts",
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "default": "./dist/browser.js"
    },
    "./universal": {
      "tgmc-portfolio": "./src/universal.ts",
      "types": "./dist/universal.d.ts",
      "import": "./dist/universal.js",
      "default": "./dist/universal.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "nx": {
    "targets": {
      "build": {
        "executor": "@nx/js:tsc",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "packages/utilities/dist",
          "main": "packages/utilities/src/index.ts",
          "tsConfig": "packages/utilities/tsconfig.lib.json",
          "rootDir": "packages/utilities/src",
          "generatePackageJson": false
        }
      },
      "test": {
        "dependsOn": [
          "build"
        ]
      }
    }
  },
  "dependencies": {
    "consola": "^3.4.2",
    "tslib": "^2.3.0"
  }
}
