",
  "core/portal/eslint.config.js": "// @ts-check
import { createConfigForNuxt } from '@nuxt/eslint-config/flat';

export default createConfigForNuxt(
  { features: { typescript: true } },
  { ignores: ['.nuxt/**', '.output/**', 'dist/**', 'node_modules/**'] },
  {
    files: ['app/app.vue', 'app/pages/**/*.vue', 'app/layouts/**/*.vue'],
    rules: { 'vue/multi-word-component-names': 'off' },
  },
  {
    files: ['server/**/*', 'app/pages/**/*', 'app/components/**/*'],
    ignores: ['**/*.client.vue', '**/*.client.ts'],
    rules: {
      'no-restricted-imports': [
        'error',
        {
          paths: [
            {
              name: '@tgmc/utilities/browser',
              message:
                'Forbidden: @tgmc/utilities/browser cannot be imported into SSR or universal code. Use @tgmc/utilities/universal or place in a *.client.{ts,vue} file.',
            },
          ],
        },
      ],
    },
  },
);
",
  "core/portal/infra/template.yaml": "AWSTemplateFormatVersion: '2010-09-09'
Transform: AWS::Serverless-2016-10-31
Description: '@tgmc/portal — Nuxt SSR on Lambda behind an HTTP API'

Parameters:
  Stage:
    Type: String
    AllowedValues: [test, production]

Globals:
  Function:
    Runtime: nodejs24.x
    MemorySize: 1024
    Timeout: 15

Resources:
  HttpApi:
    Type: AWS::Serverless::HttpApi

  NitroFunction:
    Type: AWS::Serverless::Function
    Properties:
      # Nitro aws_lambda output; public assets are inlined (serveStatic: 'inline' in nuxt.config.ts).
      CodeUri: ../.output/server
      Handler: index.handler
      Environment:
        Variables:
          NODE_ENV: production
          SYS_ENV: !Ref Stage
      Events:
        Root:
          Type: HttpApi
          Properties:
            ApiId: !Ref HttpApi
            Path: /
            Method: ANY
        Proxy:
          Type: HttpApi
          Properties:
            ApiId: !Ref HttpApi
            Path: /{proxy+}
            Method: ANY

Outputs:
  HttpApiUrl:
    Description: Base URL of the app
    Value: !Sub 'https://\${HttpApi}.execute-api.\${AWS::Region}.amazonaws.com/'
",
  "core/portal/nuxt.config.ts": "import { defineNuxtConfig } from 'nuxt/config';

// https://nuxt.com/docs/api/configuration/nuxt-config
export default defineNuxtConfig({
  compatibilityDate: '2026-04-03',
  extends: ['@tgmc/nuxt-layer-base'],

  // App-specific configuration overrides
  app: {
    head: {
      title: 'portal · TGMC',
    },
  },

  // The generated SAM stack has no S3/CloudFront, so the Lambda serves public assets itself.
  nitro:
    process.env.NITRO_PRESET === 'aws_lambda'
      ? { serveStatic: 'inline', awsLambda: { streaming: false } }
      : {},
});
",
  "core/portal/package.json": "{
  "name": "@tgmc/portal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vitest run"
  },
  "dependencies": {
    "@tgmc/nuxt-layer-base": "*",
    "@tgmc/theme": "*",
    "@tgmc/utilities": "*",
    "nuxt": "^4.5.2",
    "vue": "^3.5.0",
    "vue-router": "^5.0.0"
  },
  "devDependencies": {
    "@nuxt/eslint-config": "1.15.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "axe-core": "^4.12.1",
    "eslint": "^9",
    "jsdom": "^27.1.0",
    "vitest": "^4.1.11"
  },
  "nx": {
    "tags": [
      "type:app",
      "target:aws-sam"
    ]
  }
}
",
  "core/portal/tests/a11y.spec.ts": "import { mount } from '@vue/test-utils';
import axe from 'axe-core';
import { afterEach, describe, expect, it, vi } from 'vitest';
import IndexPage from '../app/pages/index.vue';

const WCAG_22_AA = ['wcag2a', 'wcag2aa', 'wcag21aa', 'wcag22aa'];

describe('<IndexPage /> accessibility', () => {
  afterEach(() => {
    vi.unstubAllGlobals();
    document.body.innerHTML = '';
  });

  it('has no WCAG 2.2 AA axe violations', async () => {
    vi.stubGlobal('useA11yAnnouncer', () => ({ announce: () => {} }));
    const wrapper = mount(IndexPage, { attachTo: document.body });

    const results = await axe.run(wrapper.element, {
      runOnly: { type: 'tag', values: WCAG_22_AA },
    });

    expect(results.violations.map((violation) => violation.id)).toEqual([]);
    wrapper.unmount();
  });
});
",
  "core/portal/tsconfig.json": "{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "types": ["vitest/globals"]
  },
  "include": ["app/**/*", "tests/**/*", "nuxt.config.ts"]
}
",
  "core/portal/vitest.config.ts": "import vue from '@vitejs/plugin-vue';
import { defineConfig } from 'vitest/config';

export default defineConfig({
  plugins: [vue()],
  test: {
    environment: 'jsdom',
    globals: true,
  },
});
",
  "tsconfig.json": "{
  "references": [
    {
      "path": "./core/portal"
    },
    {
      "path": "./core/portal-e2e"
    }
  ]
}
",
}
`;

exports[`nuxt-app generator > generates the expected files for docker-node 1`] = `
{
  ".github/workflows/portal-cd.yml": "# CD — Docker Node-Server deploy for @tgmc/portal
name: CD Deploy (portal - Docker)

on:
  push:
    branches:
      - main
    paths:
      - 'core/portal/**'
      - 'packages/**'
      - 'theme/**'
  workflow_dispatch:

permissions:
  contents: read
  packages: write

concurrency:
  group: cd-deploy-portal-\${{ github.ref }}
  cancel-in-progress: false

jobs:
  build-and-deploy:
    name: Build & Deploy Container
    runs-on: ubuntu-latest
    env:
      HUSKY: '0'
    steps:
      - uses: actions/checkout@v4

      - name: Setup Node.js 24
        uses: actions/setup-node@v4
        with:
          node-version: 24
          cache: npm

      - name: Install dependencies
        run: npm ci

      - name: Build SSR app
        run: npx nx run @tgmc/portal:build

      - name: Log in to Container Registry
        uses: docker/login-action@v3
        with:
          registry: ghcr.io
          username: \${{ github.actor }}
          password: \${{ secrets.GITHUB_TOKEN }}

      - name: Build and Push Docker Image
        uses: docker/build-push-action@v5
        with:
          context: .
          file: core/portal/Dockerfile
          push: true
          tags: ghcr.io/\${{ github.repository }}/portal:latest
",
  "core/portal-e2e/cypress.config.ts": "import { readFileSync } from 'node:fs';
import { createRequire } from 'node:module';
import { defineConfig } from 'cypress';

const require = createRequire(import.meta.url);

export default defineConfig({
  e2e: {
    baseUrl: process.env.E2E_BASE_URL || 'http://127.0.0.1:4200',
    specPattern: 'src/e2e/**/*.cy.ts',
    supportFile: 'src/support/e2e.ts',
    setupNodeEvents(on) {
      on('task', {
        axeSource: () =>
          readFileSync(require.resolve('axe-core/axe.min.js'), 'utf8'),
      });
    },
  },
});
",
  "core/portal-e2e/package.json": "{
  "name": "@tgmc/portal-e2e",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "devDependencies": {
    "axe-core": "^4.12.1",
    "cypress": "^15.8.0"
  },
  "nx": {
    "tags": [
      "type:e2e",
      "scope:portal"
    ],
    "implicitDependencies": [
      "@tgmc/portal"
    ],
    "targets": {
      "e2e": {
        "dependsOn": [],
        "executor": "nx:run-commands",
        "options": {
          "cwd": "{projectRoot}",
          "command": "cypress run",
          "env": {
            "TS_NODE_COMPILER_OPTIONS": "{\\"customConditions\\":null}"
          }
        },
        "outputs": [
          "{projectRoot}/test-output/cypress/videos",
          "{projectRoot}/test-output/cypress/screenshots"
        ]
      }
    }
  }
}
",
  "core/portal-e2e/src/e2e/a11y-audit.cy.ts": "describe('portal accessibility audit', () => {
  beforeEach(() => {
    cy.visit('/');
  });

  it('has no WCAG 2.2 AA axe violations on the landing page', () => {
    cy.runAxe({
      runOnly: {
        type: 'tag',
        values: ['wcag2a', 'wcag2aa', 'wcag21aa', 'wcag22aa'],
      },
    }).then((results) => {
      const summary = results.violations.map(
        (violation) => \`\${violation.id}: \${violation.nodes.length} node(s)\`,
      );
      expect(summary, 'axe violations').to.deep.equal([]);
    });
  });

  it('moves keyboard focus to a visible skip link first', () => {
    cy.press(Cypress.Keyboard.Keys.TAB);
    cy.focused().should('have.class', 'ui-skip-link').and('be.visible');
  });
});
",
  "core/portal-e2e/src/support/e2e.ts": "import type { AxeResults, RunOptions } from 'axe-core';

declare global {
  // eslint-disable-next-line @typescript-eslint/no-namespace
  namespace Cypress {
    interface Chainable {
      /** Injects axe-core into the page under test and runs it; yields the axe results. */
      runAxe(options?: RunOptions): Chainable<AxeResults>;
    }
  }
}

type AxeWindow = Window & {
  axe?: { run(context: Document, options?: RunOptions): Promise<AxeResults> };
};

Cypress.Commands.add('runAxe', (options?: RunOptions) =>
  cy.task<string>('axeSource', undefined, { log: false }).then((source) =>
    cy.window({ log: false }).then((win) => {
      const axeWindow = win as unknown as AxeWindow;
      if (!axeWindow.axe) win.eval(source);
      const axe = axeWindow.axe;
      if (!axe) throw new Error('axe-core did not load into the page');
      return axe.run(win.document, options);
    }),
  ),
);
",
