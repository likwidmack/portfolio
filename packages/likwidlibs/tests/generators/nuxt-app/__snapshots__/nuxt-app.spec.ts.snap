  "references": [
    {
      "path": "./core/portal"
    },
    {
      "path": "./core/portal-e2e"
    }
  ]
}
",
}
`;

exports[`nuxt-app generator > generates the expected files for static-cloudflare 1`] = `
{
  ".github/workflows/portal-cd.yml": "# CD — Static Jamstack / Cloudflare Pages deploy for @tgmc/portal
name: CD Deploy (portal - Static)

on:
  push:
    branches:
      - main
    paths:
      - 'core/portal/**'
      - 'packages/**'
      - 'theme/**'
  workflow_dispatch:

permissions:
  contents: read
  deployments: write

concurrency:
  group: cd-deploy-portal-\${{ github.ref }}
  cancel-in-progress: false

jobs:
  build-and-deploy:
    name: Generate & Deploy Pages
    runs-on: ubuntu-latest
    env:
      HUSKY: '0'
    steps:
      - uses: actions/checkout@v4

      - name: Setup Node.js 24
        uses: actions/setup-node@v4
        with:
          node-version: 24
          cache: npm

      - name: Install dependencies
        run: npm ci

      - name: Generate static output
        run: npx nx run @tgmc/portal:generate

      - name: Deploy to Cloudflare Pages
        uses: cloudflare/pages-action@v1
        with:
          apiToken: \${{ secrets.CLOUDFLARE_API_TOKEN }}
          accountId: \${{ secrets.CLOUDFLARE_ACCOUNT_ID }}
          projectName: portal
          directory: core/portal/dist
",
  "core/portal-e2e/cypress.config.ts": "import { readFileSync } from 'node:fs';
import { createRequire } from 'node:module';
import { defineConfig } from 'cypress';

const require = createRequire(import.meta.url);

export default defineConfig({
  e2e: {
    baseUrl: process.env.E2E_BASE_URL || 'http://127.0.0.1:4200',
    specPattern: 'src/e2e/**/*.cy.ts',
    supportFile: 'src/support/e2e.ts',
    setupNodeEvents(on) {
      on('task', {
        axeSource: () =>
          readFileSync(require.resolve('axe-core/axe.min.js'), 'utf8'),
      });
    },
  },
});
",
  "core/portal-e2e/package.json": "{
  "name": "@tgmc/portal-e2e",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "devDependencies": {
    "axe-core": "^4.12.1",
    "cypress": "^15.8.0"
  },
  "nx": {
    "tags": [
      "type:e2e",
      "scope:portal"
    ],
    "implicitDependencies": [
      "@tgmc/portal"
    ],
    "targets": {
      "e2e": {
        "dependsOn": [],
        "executor": "nx:run-commands",
        "options": {
          "cwd": "{projectRoot}",
          "command": "cypress run",
          "env": {
            "TS_NODE_COMPILER_OPTIONS": "{\\"customConditions\\":null}"
          }
        },
        "outputs": [
          "{projectRoot}/test-output/cypress/videos",
          "{projectRoot}/test-output/cypress/screenshots"
        ]
      }
    }
  }
}
",
  "core/portal-e2e/src/e2e/a11y-audit.cy.ts": "describe('portal accessibility audit', () => {
  beforeEach(() => {
    cy.visit('/');
  });

  it('has no WCAG 2.2 AA axe violations on the landing page', () => {
    cy.runAxe({
      runOnly: {
        type: 'tag',
        values: ['wcag2a', 'wcag2aa', 'wcag21aa', 'wcag22aa'],
      },
    }).then((results) => {
      const summary = results.violations.map(
        (violation) => \`\${violation.id}: \${violation.nodes.length} node(s)\`,
      );
      expect(summary, 'axe violations').to.deep.equal([]);
    });
  });

  it('moves keyboard focus to a visible skip link first', () => {
    cy.press(Cypress.Keyboard.Keys.TAB);
    cy.focused().should('have.class', 'ui-skip-link').and('be.visible');
  });
});
",
