// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`nuxt-app generator > generates the expected files for aws-sam 1`] = `
{
  ".github/workflows/portal-cd-prod.yml": "# CD — AWS SAM production deploy for @tgmc/portal. Mirrors .github/workflows/cd-aws-prod.yml:
#   - GitHub Release published (non-prerelease) → deploy the tagged commit after production Environment approval
#   - workflow_dispatch → requires input confirm=deploy + production Environment approval
name: CD Deploy (portal - AWS SAM production)

on:
  release:
    types: [published]
  workflow_dispatch:
    inputs:
      confirm:
        description: 'Type deploy to confirm production release'
        required: true
        default: ''

permissions:
  contents: read
  id-token: write # AWS OIDC

concurrency:
  group: cd-deploy-portal-prod
  cancel-in-progress: false

jobs:
  deploy-production:
    name: SAM deploy (production)
    runs-on: ubuntu-latest
    if: github.event_name == 'workflow_dispatch' || !github.event.release.prerelease
    environment: production
    env:
      HUSKY: '0'
      AWS_REGION: \${{ vars.AWS_REGION || secrets.AWS_REGION || 'us-west-2' }}
    steps:
      - name: Confirm production intent (manual dispatch only)
        if: github.event_name == 'workflow_dispatch'
        run: |
          if [ "\${{ github.event.inputs.confirm }}" != "deploy" ]; then
            echo "Refusing production deploy: set input confirm=deploy"
            exit 1
          fi

      - name: Checkout
        uses: actions/checkout@v4
        with:
          ref: \${{ github.event_name == 'release' && github.event.release.tag_name || github.ref }}

      - name: Use Node.js 24
        uses: actions/setup-node@v4
        with:
          node-version: 24
          cache: npm

      - name: Setup SAM CLI
        uses: aws-actions/setup-sam@v2
        with:
          use-installer: true

      - name: Configure AWS credentials (OIDC)
        uses: aws-actions/configure-aws-credentials@v4
        with:
          role-to-assume: \${{ secrets.AWS_ROLE_ARN }}
          aws-region: \${{ env.AWS_REGION }}

      - name: Install dependencies
        run: npm ci

      - name: Build workspace libraries
        run: npm run build:libs

      - name: Build SSR app for Lambda
        run: npx nx run @tgmc/portal:build
        env:
          SYS_ENV: production
          NITRO_PRESET: aws_lambda

      - name: SAM deploy
        run: |
          sam deploy \\
            --template-file core/portal/infra/template.yaml \\
            --stack-name tgmc-portal-prod \\
            --parameter-overrides Stage=production \\
            --capabilities CAPABILITY_IAM \\
            --resolve-s3 \\
            --no-confirm-changeset \\
            --no-fail-on-empty-changeset

      - name: Smoke test
        run: |
          url=$(aws cloudformation describe-stacks --stack-name tgmc-portal-prod \\
            --query "Stacks[0].Outputs[?OutputKey=='HttpApiUrl'].OutputValue" --output text)
          curl --fail --silent --show-error --retry 5 --retry-delay 5 --output /dev/null "$url"
",
  ".github/workflows/portal-cd.yml": "# CD — AWS SAM test deploy for @tgmc/portal. Mirrors .github/workflows/cd-aws.yml:
# a gate job decides whether the app is affected, then deploy-test runs in the \`test\` Environment
# (its AWS_ROLE_ARN secret is trusted by repo:OWNER/REPO:environment:test — docs/cicd.md).
name: CD Deploy (portal - AWS SAM test)

on:
  push:
    branches:
      - main
    paths:
      - 'core/portal/**'
      - 'packages/**'
      - 'theme/**'
  workflow_dispatch:

permissions:
  contents: read
  id-token: write # AWS OIDC

concurrency:
  group: cd-deploy-portal-test
  cancel-in-progress: false

jobs:
  deployable-gate:
    name: Deployable gate
    runs-on: ubuntu-latest
    env:
      HUSKY: '0'
    outputs:
      deployable: \${{ steps.gate.outputs.deployable }}
    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Use Node.js 24
        if: github.event_name == 'push'
        uses: actions/setup-node@v4
        with:
          node-version: 24
          cache: npm

      - name: Install dependencies
        if: github.event_name == 'push'
        run: npm ci

      - name: Derive Nx base/head
        if: github.event_name == 'push'
        uses: nrwl/nx-set-shas@v4

      - name: Is @tgmc/portal affected?
        id: gate
        run: |
          if [ "\${{ github.event_name }}" = "workflow_dispatch" ]; then
            echo "deployable=true" >> "$GITHUB_OUTPUT"
          elif npx nx show projects --affected --base="$NX_BASE" --head="$NX_HEAD" | grep -qx '@tgmc/portal'; then
            echo "deployable=true" >> "$GITHUB_OUTPUT"
          else
            echo "deployable=false" >> "$GITHUB_OUTPUT"
          fi

  deploy-test:
    name: SAM deploy (test)
    needs: deployable-gate
    if: needs.deployable-gate.outputs.deployable == 'true'
    runs-on: ubuntu-latest
    environment: test
    env:
      HUSKY: '0'
      AWS_REGION: \${{ vars.AWS_REGION || secrets.AWS_REGION || 'us-west-2' }}
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Use Node.js 24
        uses: actions/setup-node@v4
        with:
          node-version: 24
          cache: npm

      - name: Setup SAM CLI
        uses: aws-actions/setup-sam@v2
        with:
          use-installer: true

      - name: Configure AWS credentials (OIDC)
        uses: aws-actions/configure-aws-credentials@v4
        with:
          role-to-assume: \${{ secrets.AWS_ROLE_ARN }}
          aws-region: \${{ env.AWS_REGION }}

      - name: Install dependencies
        run: npm ci

      - name: Build workspace libraries
        run: npm run build:libs

      - name: Build SSR app for Lambda
        run: npx nx run @tgmc/portal:build
        env:
          SYS_ENV: test
          NITRO_PRESET: aws_lambda

      - name: SAM deploy
        run: |
          sam deploy \\
            --template-file core/portal/infra/template.yaml \\
            --stack-name tgmc-portal-test \\
            --parameter-overrides Stage=test \\
            --capabilities CAPABILITY_IAM \\
            --resolve-s3 \\
            --no-confirm-changeset \\
            --no-fail-on-empty-changeset

      - name: Smoke test
        run: |
          url=$(aws cloudformation describe-stacks --stack-name tgmc-portal-test \\
            --query "Stacks[0].Outputs[?OutputKey=='HttpApiUrl'].OutputValue" --output text)
          curl --fail --silent --show-error --retry 5 --retry-delay 5 --output /dev/null "$url"
",
  "core/portal-e2e/cypress.config.ts": "import { readFileSync } from 'node:fs';
import { createRequire } from 'node:module';
import { defineConfig } from 'cypress';

const require = createRequire(import.meta.url);

export default defineConfig({
  e2e: {
    baseUrl: process.env.E2E_BASE_URL || 'http://127.0.0.1:4200',
    specPattern: 'src/e2e/**/*.cy.ts',
    supportFile: 'src/support/e2e.ts',
    setupNodeEvents(on) {
      on('task', {
        axeSource: () =>
          readFileSync(require.resolve('axe-core/axe.min.js'), 'utf8'),
      });
    },
  },
});
",
  "core/portal-e2e/package.json": "{
  "name": "@tgmc/portal-e2e",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "devDependencies": {
    "axe-core": "^4.12.1",
    "cypress": "^15.8.0"
  },
  "nx": {
    "tags": [
      "type:e2e",
      "scope:portal"
    ],
    "implicitDependencies": [
      "@tgmc/portal"
    ],
    "targets": {
      "e2e": {
        "dependsOn": [],
        "executor": "nx:run-commands",
        "options": {
          "cwd": "{projectRoot}",
          "command": "cypress run",
          "env": {
            "TS_NODE_COMPILER_OPTIONS": "{\\"customConditions\\":null}"
          }
        },
        "outputs": [
          "{projectRoot}/test-output/cypress/videos",
          "{projectRoot}/test-output/cypress/screenshots"
        ]
      }
    }
  }
}
",
  "core/portal-e2e/src/e2e/a11y-audit.cy.ts": "describe('portal accessibility audit', () => {
  beforeEach(() => {
    cy.visit('/');
  });

  it('has no WCAG 2.2 AA axe violations on the landing page', () => {
    cy.runAxe({
      runOnly: {
        type: 'tag',
        values: ['wcag2a', 'wcag2aa', 'wcag21aa', 'wcag22aa'],
      },
    }).then((results) => {
      const summary = results.violations.map(
        (violation) => \`\${violation.id}: \${violation.nodes.length} node(s)\`,
      );
      expect(summary, 'axe violations').to.deep.equal([]);
    });
  });

  it('moves keyboard focus to a visible skip link first', () => {
    cy.press(Cypress.Keyboard.Keys.TAB);
    cy.focused().should('have.class', 'ui-skip-link').and('be.visible');
  });
});
",
  "core/portal-e2e/src/support/e2e.ts": "import type { AxeResults, RunOptions } from 'axe-core';

declare global {
  // eslint-disable-next-line @typescript-eslint/no-namespace
  namespace Cypress {
    interface Chainable {
      /** Injects axe-core into the page under test and runs it; yields the axe results. */
      runAxe(options?: RunOptions): Chainable<AxeResults>;
    }
  }
}

type AxeWindow = Window & {
  axe?: { run(context: Document, options?: RunOptions): Promise<AxeResults> };
};

Cypress.Commands.add('runAxe', (options?: RunOptions) =>
  cy.task<string>('axeSource', undefined, { log: false }).then((source) =>
    cy.window({ log: false }).then((win) => {
      const axeWindow = win as unknown as AxeWindow;
      if (!axeWindow.axe) win.eval(source);
      const axe = axeWindow.axe;
      if (!axe) throw new Error('axe-core did not load into the page');
      return axe.run(win.document, options);
    }),
  ),
);
",
  "core/portal-e2e/tsconfig.json": "{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "out-tsc/cypress",
    "allowJs": true,
    "lib": ["es2022", "dom"],
    "types": ["cypress", "node"],
    "sourceMap": false
  },
  "include": [
    "**/*.ts",
    "**/*.js",
    "cypress.config.ts",
    "**/*.cy.ts",
    "**/*.d.ts"
  ],
  "exclude": ["out-tsc", "test-output", "eslint.config.js"]
}
",
