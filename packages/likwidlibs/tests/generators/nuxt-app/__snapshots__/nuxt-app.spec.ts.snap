  "core/portal/app/pages/index.vue": "<script setup lang="ts">
const { announce } = useA11yAnnouncer();

function handleAction() {
  announce('Action performed successfully', 'polite');
}
</script>

<template>
  <section class="welcome-hero" aria-labelledby="hero-title">
