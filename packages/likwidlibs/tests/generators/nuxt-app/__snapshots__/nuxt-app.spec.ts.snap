  "core/portal/app/pages/index.vue": "<script setup lang="ts">
const { announce } = useA11yAnnouncer();

function handleAction() {
  announce('Action performed successfully', 'polite');
}
</script>

<template>
  <section class="welcome-hero" aria-labelledby="hero-title">
    <h1 id="hero-title">Welcome to portal</h1>
    <p class="hero-tagline">
      Scaffolded with TGMC Nuxt 4 base layer, design tokens, and WCAG 2.2 AA
      accessibility.
    </p>
    <div class="action-row">
      <button type="button" class="action-btn" @click="handleAction">
        Get Started
      </button>
    </div>
  </section>
</template>

