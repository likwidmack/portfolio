{
  "name": "@tgmc/<%= name %>",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vitest run"
  },
  "dependencies": {
    "@tgmc/nuxt-layer-base": "*",
    "@tgmc/theme": "*",
    "@tgmc/utilities": "*",
    "nuxt": "^4.5.2",
    "vue": "^3.5.0",
    "vue-router": "^5.0.0"
  },
  "devDependencies": {
    "@nuxt/eslint-config": "1.15.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "axe-core": "^4.12.1",
    "eslint": "^9",
    "jsdom": "^27.1.0",
    "vitest": "^4.1.11"
  },
  "nx": {
    "tags": ["type:app", "target:<%= deploymentTarget %>"]
  }
}
