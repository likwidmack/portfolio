{
  "name": "@tgmc/likwidlibs",
  "version": "0.0.1",
  "description": "Nx workspace plugin and generators for TGMC packages.",
  "author": "Tamara G Mack",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git@github.com:likwidmack/portfolio.git",
    "directory": "packages/likwidlibs"
  },
  "homepage": "https://github.com/likwidmack/portfolio/tree/main/packages/likwidlibs",
  "bugs": {
    "url": "https://github.com/likwidmack/portfolio/issues"
  },
  "keywords": [
    "nx",
    "nx-plugin",
    "generators",
    "tgmc",
    "likwidlibs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "tgmc-portfolio": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.lib.json && node ./copy-build-assets.mjs",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo",
    "generators.json"
  ],
  "generators": "./generators.json",
  "nx": {
    "targets": {
      "build": {
        "executor": "@nx/js:tsc",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "packages/likwidlibs/dist",
          "main": "packages/likwidlibs/src/index.ts",
          "tsConfig": "packages/likwidlibs/tsconfig.lib.json",
          "rootDir": "packages/likwidlibs/src",
          "generatePackageJson": false,
          "assets": [
            {
              "input": "./packages/likwidlibs/src",
              "glob": "**/!(*.ts)",
              "output": "."
            },
            {
              "input": "./packages/likwidlibs/src",
              "glob": "**/*.d.ts",
              "output": "."
            }
          ]
        }
      }
    }
  },
  "dependencies": {
    "@nx/devkit": "22.7.8",
    "tslib": "^2.3.0"
  }
}
