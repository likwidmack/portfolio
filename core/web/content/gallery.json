          "likes": 180,
          "summary": "A cluster of repo scripts for parsing, reshaping, and enriching structured content so cleanup work stays repeatable instead of becoming a one-off editing session.",
          "role": "Designed for safe iteration on local content and design-token data.",
          "stack": ["Node.js", "JSON transforms", "CLI workflows"],
          "motif": "spectrum",
          "tone": "signal",
          "exhibit": {
            "kind": "code",
            "language": "js",
            "filename": "refactor-content.mjs",
            "source": "import { readFile, writeFile } from 'node:fs/promises';\n\nexport async function reshape(path, map) {\n  const raw = JSON.parse(await readFile(path, 'utf8'));\n  const next = map(raw);\n  await writeFile(path, `${JSON.stringify(next, null, 2)}\\n`);\n  return next;\n}\n"
          }
        },
        {
