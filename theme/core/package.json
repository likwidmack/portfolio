{
  "name": "@tgmc/theme",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "TGMC design tokens, layered SCSS (Normalize/Foundation/PrimeVue), and runtime theme helpers.",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    "./tokens": {
      "types": "./dist/tokens-public.d.ts",
      "import": "./dist/tokens-public.js",
      "default": "./dist/tokens-public.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./primevue": {
      "types": "./dist/primevue.d.ts",
      "import": "./dist/primevue.js",
      "default": "./dist/primevue.js"
    },
    "./scss": "./scss/index.scss",
    "./scss/*": "./scss/*",
    "./scss/tokens": "./scss/tokens/_index.scss",
    "./scss/tokens/overrides": "./scss/tokens/_overrides.scss",
    "./scss/config": "./scss/_config.scss",
    "./scss/globals": "./scss/globals/_index.scss",
    "./scss/mixins": "./scss/globals/_mixins.scss"
  },
  "scripts": {
    "build": "tsc -p tsconfig.lib.json"
  },
  "files": [
    "dist",
    "scss",
    "!**/*.tsbuildinfo"
  ],
  "nx": {
    "targets": {
      "build": {
        "executor": "@nx/js:tsc",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "theme/core/dist",
          "main": "theme/core/src/index.ts",
          "tsConfig": "theme/core/tsconfig.lib.json",
          "rootDir": "theme/core/src",
          "generatePackageJson": false,
          "assets": [
            {
              "input": "./theme/core/scss",
              "glob": "**/*",
              "output": "./scss"
            }
          ]
        }
      }
    }
  },
  "dependencies": {
    "@primeuix/themes": "*",
    "@tgmc/theme-foundation": "*",
    "@tgmc/theme-primevue": "*",
    "tslib": "^2.3.0"
  },
  "peerDependencies": {
    "@primevue/nuxt-module": ">=4",
    "primevue": ">=4"
  },
  "peerDependenciesMeta": {
    "@primevue/nuxt-module": {
      "optional": true
    },
    "primevue": {
      "optional": true
    }
  },
  "keywords": [
    "scss",
    "theme",
    "nuxt",
    "css-layers",
    "tgmc"
  ]
}
