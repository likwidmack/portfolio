{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": false,
    "declarationMap": false,
    "forceConsistentCasingInFileNames": true,
    "lib": ["es2022", "dom"]
  },
  "include": ["src/**/*.ts"],
  "references": [],
  "exclude": ["src/**/*.spec.ts", "src/**/*.test.ts"]
}
