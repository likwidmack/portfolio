{
  "name": "@tgmc/theme-primevue",
  "version": "3.52.0",
  "private": true,
  "description": "Thin workspace wrapper over PrimeVue Sass themes for @tgmc/theme layers.",
  "license": "MIT",
  "exports": {
    "./package.json": "./package.json",
