# Suppress upstream Node.js DEP0155 trailing-slash export map warnings
# that come from @vue/shared, @primeuix/utils, and @shikijs/core.
# These are not actionable from this codebase — the packages need to update
# their package.json exports fields.
node-options=--no-deprecation

# Fail install below package.json engines (`>=24`). Blocks Node 20; Node 24+ is OK.
engine-strict=true
